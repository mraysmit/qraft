<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.mars</groupId>
        <artifactId>qraft</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>qraft-runtime</artifactId>
    <packaging>jar</packaging>
    <name>Qraft Runtime</name>
    <description>Single executable Qraft runtime with server and client startup modes</description>

    <properties>
        <!-- Default: skip the end-to-end tests that wait out real TTLs and elections (docs/TESTING.md).
             Run them with the Docker suite: -Dgroups=docker,e2e -Dtest.excludedGroups= -->
        <test.excludedGroups>e2e</test.excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.mars</groupId>
            <artifactId>qraft-controller</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.mars</groupId>
            <artifactId>qraft-controller</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.mars</groupId>
            <artifactId>qraft-agent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The root POM gives every module Logback in test scope, which would keep it out of the
             executable jar. Server and client both log through it at run time. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>qraft-runtime</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <!-- Rebuild this module's own jar on every build. The shade step below replaces it with the
                 executable jar; if the jar step then kept that file as up to date, the next build would
                 shade the previous executable jar and keep its old copies of every dependency. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <forceCreation>true</forceCreation>
                </configuration>
            </plugin>
            <!-- The one executable jar. No other module shades: a module that shaded its own jar would hand
                 this step a second, possibly stale, copy of each dependency. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.mars.qraft.runtime.QraftRuntimeApplication</mainClass>
                                </transformer>
                                <!-- gRPC and others find their providers through META-INF/services files that
                                     several jars define; they must be merged, not first-one-wins. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
