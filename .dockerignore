# =============================================================================
# Docker build context exclusions for qraft
# Reduces context transfer from ~100MB to ~10MB per build.
# =============================================================================

# Build outputs; the runtime JAR is the sole host-built artifact packaged.
**/target/
!target/
target/*
!target/qraft.jar

# Version control
.git/

# IDE / editor state
.idea/
.history/
.vscode/
**/*.iml

# Runtime data (not needed for image builds)
data/
logs/
downloads/
corporate-data/
temp/

# Documentation
docs/
docs-design/

# Docker compose configs (not needed inside image builds); the image needs only its entrypoint
docker/
!docker/docker-entrypoint.sh

# Scripts
scripts/

# Root-level files not needed for builds
*.json
LICENSE
NOTICE
OPEN_SOURCE_USAGE.md
